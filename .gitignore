.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# Kotlin compiler daemon caches
.kotlin/

# IDEs
.idea/
*.iml
.vscode/

# macOS
.DS_Store

# Local server data, generated at runtime and never committed. These are patterns rather than
# exact paths on purpose: the earlier list named `basalt_server_test_world/` and `/world/`, which
# matched neither `basalt-server/basalt_server_test_world_39566/` nor the current `worlds/` layout,
# so test worlds and player databases were committed for several releases without anyone noticing.
# Tests now write under build/ instead, and these are the net that catches the next mistake.
eula.txt
config/
.basalt/
logs/
worlds/
world/
*.linear
*.db
*.db-shm
*.db-wal
