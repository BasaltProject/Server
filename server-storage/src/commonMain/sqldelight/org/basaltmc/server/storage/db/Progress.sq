-- What a player has been granted and taught: advancement criteria, and recipes in their book.
--
-- Vanilla keeps advancement progress in `advancements/<uuid>.json` inside the world folder and the
-- recipe book inside `playerdata/<uuid>.dat`, so both die with the world. Here they live with the
-- player, for the same reason everything else about a player does.
--
-- One row per criterion rather than a blob per player, because that is the unit `/advancement grant
-- ... only <criterion>` writes, and because "who has this advancement" is then a query rather than
-- a scan that deserializes everyone.
CREATE TABLE advancement_criterion (
    uuid TEXT NOT NULL,
    advancement TEXT NOT NULL,
    criterion TEXT NOT NULL,
    PRIMARY KEY (uuid, advancement, criterion)
);

CREATE TABLE known_recipe (
    uuid TEXT NOT NULL,
    recipe TEXT NOT NULL,
    PRIMARY KEY (uuid, recipe)
);

selectCriteria:
SELECT advancement, criterion FROM advancement_criterion WHERE uuid = ?;

grantCriterion:
INSERT OR IGNORE INTO advancement_criterion(uuid, advancement, criterion) VALUES (?, ?, ?);

revokeCriterion:
DELETE FROM advancement_criterion WHERE uuid = ? AND advancement = ? AND criterion = ?;

revokeAdvancement:
DELETE FROM advancement_criterion WHERE uuid = ? AND advancement = ?;

selectRecipes:
SELECT recipe FROM known_recipe WHERE uuid = ?;

learnRecipe:
INSERT OR IGNORE INTO known_recipe(uuid, recipe) VALUES (?, ?);

forgetRecipe:
DELETE FROM known_recipe WHERE uuid = ? AND recipe = ?;
