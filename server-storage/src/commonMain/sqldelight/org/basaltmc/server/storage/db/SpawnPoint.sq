-- Where a player respawns, as `/spawnpoint` sets it.
--
-- Its own table rather than columns on `player`, because it is written by a command that may name
-- somebody who has never joined, and the whole-player upsert would then have to invent the rest of
-- their row. A missing row means "wherever the world spawns", which is the vanilla default.
CREATE TABLE spawn_point (
    uuid TEXT NOT NULL PRIMARY KEY,
    world TEXT NOT NULL,
    x REAL NOT NULL,
    y REAL NOT NULL,
    z REAL NOT NULL,
    yaw REAL NOT NULL
);

selectSpawnPoint:
SELECT * FROM spawn_point WHERE uuid = ?;

setSpawnPoint:
INSERT OR REPLACE INTO spawn_point(uuid, world, x, y, z, yaw) VALUES (?, ?, ?, ?, ?, ?);

deleteSpawnPoint:
DELETE FROM spawn_point WHERE uuid = ?;
