-- Who may connect: bans by player, bans by address, and the whitelist.
--
-- In the same database as players and not in `config/`, because these are state the server writes,
-- not configuration the operator maintains by hand.
CREATE TABLE ban (
    -- The player's UUID, or the address for an IP ban. One table, because both answer the same
    -- question at login and a two-table version needs the same union query anyway.
    subject TEXT NOT NULL PRIMARY KEY,
    -- 'player' or 'ip', so a UUID that looks like an address cannot collide with one.
    kind TEXT NOT NULL,
    -- What to show whoever it applies to, and who set it.
    name TEXT,
    reason TEXT NOT NULL,
    source TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    -- Null means it never expires, which is every ban vanilla's own commands create.
    expires_at INTEGER
);

CREATE INDEX ban_kind ON ban(kind);

CREATE TABLE whitelist (
    uuid TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    added_at INTEGER NOT NULL
);

CREATE INDEX whitelist_name ON whitelist(name);

selectBan:
SELECT * FROM ban WHERE subject = ? AND kind = ?;

listBans:
SELECT * FROM ban WHERE kind = ? ORDER BY created_at;

insertBan:
INSERT OR REPLACE INTO ban(subject, kind, name, reason, source, created_at, expires_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteBan:
DELETE FROM ban WHERE subject = ? AND kind = ?;

countBans:
SELECT count(*) FROM ban WHERE kind = ?;

selectWhitelisted:
SELECT * FROM whitelist WHERE uuid = ?;

selectWhitelistedByName:
SELECT * FROM whitelist WHERE name = ? COLLATE NOCASE LIMIT 1;

listWhitelist:
SELECT * FROM whitelist ORDER BY name;

insertWhitelist:
INSERT OR REPLACE INTO whitelist(uuid, name, added_at) VALUES (?, ?, ?);

deleteWhitelist:
DELETE FROM whitelist WHERE uuid = ?;
