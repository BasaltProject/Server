-- One row per player, keyed by UUID, in a database that lives outside every world directory.
--
-- Vanilla writes this state into the world folder (`playerdata/<uuid>.dat`), which is what makes a
-- world impossible to delete or reset without destroying player state along with it, and what makes
-- per-world inventories a plugin's problem. Keeping it here is the whole point of the layout.
--
-- Indexable facts are columns; anything with nested structure (items and their enchantments, custom
-- NBT) is a single binary blob on the same row. Splitting an inventory into one row per slot buys
-- joins and no queries anyone actually runs: it is always read and written whole.
CREATE TABLE player (
    uuid TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    last_seen INTEGER NOT NULL,
    first_seen INTEGER NOT NULL,
    play_time_ticks INTEGER NOT NULL DEFAULT 0,
    world TEXT NOT NULL,
    x REAL NOT NULL,
    y REAL NOT NULL,
    z REAL NOT NULL,
    yaw REAL NOT NULL,
    pitch REAL NOT NULL,
    health REAL NOT NULL,
    food INTEGER NOT NULL,
    saturation REAL NOT NULL,
    exhaustion REAL NOT NULL,
    xp_level INTEGER NOT NULL,
    xp_progress REAL NOT NULL,
    xp_total INTEGER NOT NULL,
    gamemode INTEGER NOT NULL,
    -- Which permission group they are in. Null means whichever group is currently the default,
    -- resolved at read time so renaming that group does not mean rewriting every row.
    group_name TEXT,
    -- The address they last logged in from, and only that: it is written when config/server_list.toml
    -- turns the greeting on, so that the server list can say hello by name. Never read by anything
    -- that decides what a player may do, because an address identifies a router, not a person.
    last_ip TEXT,
    inventory BLOB,
    ender_chest BLOB,
    stats BLOB,
    -- Scoreboard tags, comma-separated. A list rather than a table because it is always read and
    -- written whole, exactly like the inventory blob above it.
    tags TEXT
);

-- Name lookup is how an operator refers to a player; the other two are what the admin queries scan.
CREATE INDEX player_name ON player(name);
CREATE INDEX player_last_seen ON player(last_seen);
CREATE INDEX player_world ON player(world);
-- Looked up on every server list ping that greets by name, which is a request anyone can send.
CREATE INDEX player_last_ip ON player(last_ip);

selectByUuid:
SELECT * FROM player WHERE uuid = ?;

-- A name is not unique and never was: the same person has one row per UUID they have joined with,
-- and a server that has run in both online and offline mode has two for everybody. Most recently
-- seen wins, so `op <name>` acts on whoever that name last belonged to instead of failing outright
-- (which is what it did: "ResultSet returned more than 1 row").
selectByName:
SELECT * FROM player WHERE name = ? COLLATE NOCASE ORDER BY last_seen DESC LIMIT 1;

exists:
SELECT EXISTS(SELECT 1 FROM player WHERE uuid = ?);

upsert:
INSERT INTO player(
    uuid, name, last_seen, first_seen, play_time_ticks, world, x, y, z, yaw, pitch,
    health, food, saturation, exhaustion, xp_level, xp_progress, xp_total, gamemode,
    group_name, inventory, ender_chest, stats, tags
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(uuid) DO UPDATE SET
    name = excluded.name,
    last_seen = excluded.last_seen,
    play_time_ticks = excluded.play_time_ticks,
    world = excluded.world,
    x = excluded.x, y = excluded.y, z = excluded.z,
    yaw = excluded.yaw, pitch = excluded.pitch,
    health = excluded.health,
    food = excluded.food,
    saturation = excluded.saturation,
    exhaustion = excluded.exhaustion,
    xp_level = excluded.xp_level,
    xp_progress = excluded.xp_progress,
    xp_total = excluded.xp_total,
    gamemode = excluded.gamemode,
    group_name = excluded.group_name,
    inventory = excluded.inventory,
    ender_chest = excluded.ender_chest,
    stats = excluded.stats,
    tags = excluded.tags;

delete:
DELETE FROM player WHERE uuid = ?;

-- Admin queries. Every one of these answers without touching a blob, which is the reason the
-- indexable facts are columns in the first place.
countAll:
SELECT count(*) FROM player;

countByGamemode:
SELECT gamemode, count(*) AS total FROM player GROUP BY gamemode;

findByLastSeenBefore:
SELECT uuid, name, last_seen FROM player WHERE last_seen < ? ORDER BY last_seen;

findByWorld:
SELECT uuid, name, world FROM player WHERE world = ? ORDER BY name;

-- Group membership, kept separate from the whole-player upsert so that `op` on someone who is
-- offline does not need to invent the rest of their row.
setGroup:
UPDATE player SET group_name = ? WHERE uuid = ?;

findByGroup:
SELECT uuid, name, group_name FROM player WHERE group_name = ? ORDER BY name;

-- Kept out of the whole-player upsert so that turning the greeting off stops new addresses being
-- written without erasing the ones already there.
setLastIp:
UPDATE player SET last_ip = ? WHERE uuid = ?;

-- Most recently seen wins: a household shares one address, and the last person to play on it is the
-- best guess available. A guess is all this is ever used for.
findNameByLastIp:
SELECT name FROM player WHERE last_ip = ? ORDER BY last_seen DESC LIMIT 1;

findByPlayTimeAtLeast:
SELECT uuid, name, play_time_ticks FROM player WHERE play_time_ticks >= ? ORDER BY play_time_ticks DESC;
