# A selected Bukkit build must never silently embed an incomplete runtime.
file(REMOVE_RECURSE "${TEST_ROOT}")
set(_shim "${TEST_ROOT}/shim with spaces")
set(_runtime "${TEST_ROOT}/runtime with spaces")
set(_out "${TEST_ROOT}/embedded with spaces")
file(MAKE_DIRECTORY "${_shim}" "${_runtime}")
if(CMAKE_HOST_APPLE)
    set(_lib libjvm.dylib)
else()
    set(_lib libjvm.so)
endif()

function(stage EXPECT_SUCCESS)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSHIM=${_shim}" "-DRUNTIME=${_runtime}" "-DOUT=${_out}"
                            -P "${STAGE_SCRIPT}"
                    RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
    if(EXPECT_SUCCESS AND NOT _result EQUAL 0)
        message(FATAL_ERROR "Complete runtime rejected: ${_stdout}${_stderr}")
    elseif(NOT EXPECT_SUCCESS AND _result EQUAL 0)
        message(FATAL_ERROR "Incomplete runtime accepted")
    endif()
endfunction()

set(_sources "${_shim}/${_lib}" "${_shim}/classpath.jar" "${_runtime}/basalt-bukkit.jar" "${_runtime}/libs.txt")
foreach(_source IN LISTS _sources)
    stage(FALSE)
    file(WRITE "${_source}" "")
    stage(FALSE)
    file(WRITE "${_source}" "fixture:${_source}")
endforeach()
stage(TRUE)
stage(TRUE)

set(_names libjvm boot.jar runtime.jar libs.txt)
foreach(_index RANGE 0 3)
    list(GET _sources ${_index} _source)
    list(GET _names ${_index} _name)
    file(SHA256 "${_source}" _expected)
    file(SHA256 "${_out}/${_name}" _actual)
    if(NOT _expected STREQUAL _actual)
        message(FATAL_ERROR "Incorrect embedded contents for ${_name}")
    endif()
endforeach()
